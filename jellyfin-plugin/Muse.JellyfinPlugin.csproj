<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Muse.JellyfinPlugin</RootNamespace>
    <AssemblyName>Muse.JellyfinPlugin</AssemblyName>
    <!-- Match this to the Jellyfin server version you're building against — the
         IHomeScreenSection API in particular is newer/less stable than the rest of the
         plugin ABI, see HomeScreen/README.md. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions here are placeholders — pin these to match your target Jellyfin server
         version (Dashboard -> General shows the server version). These packages are not
         resolvable without a Jellyfin NuGet feed / local reference; see README.md. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.9.*" />
    <PackageReference Include="Jellyfin.Model" Version="10.9.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration/configPage.html" />
  </ItemGroup>

</Project>
