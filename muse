#!/usr/bin/env python3
"""muse: set up and run Muse. Needs only Python 3.9+ and Docker Compose v2 on the host.

  ./muse setup            guided setup: checks, Jellyfin, hardware, secrets, start, verify
  ./muse up | down | restart | logs [service]
  ./muse status [--json] [--url]
  ./muse doctor           find and explain problems
  ./muse upgrade          pull, rebuild, restart (migrations run automatically)
  ./muse keys             show the keys clients need (Vesper, Jellyfin plugin, MCP)
  ./muse ca               print the TLS root certificate (lan/tailscale mode)
  ./muse import KIND FILE --user ID [--profile NAME]
  ./muse users
  ./muse export-user ID [--out FILE]
  ./muse forget-user ID
  ./muse backup [--out FILE]
  ./muse restore FILE      (into a scratch database first; your data is untouched if it fails)
  ./muse rotate-keys
  ./muse rebuild

Everything personal Muse stores is encrypted with the key in secrets/muse_master_key.
Keep a copy of that file somewhere safe and separate from your backups.
"""

from __future__ import annotations

