def cmd_backup(a) -> None:
    need_setup()
    out = Path(a.out or time.strftime("muse-%Y%m%d-%H%M%S.muse-backup"))
    dump = subprocess.Popen(
        ["docker", "compose", "exec", "-T", "postgres", "sh", "-c",
         'PGPASSWORD="$(cat /run/secrets/postgres_password)" pg_dump -h 127.0.0.1 -U muse -Fc muse'],
        cwd=ROOT, stdout=subprocess.PIPE,
    )
    fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as f:
        enc = subprocess.run(["docker", "compose", "--progress", "quiet", "run", "--rm", "--no-deps", "-T", "admin", "encrypt-stream"],
                             cwd=ROOT, stdin=dump.stdout, stdout=f)
    dump.wait()
    if dump.returncode or enc.returncode:
        out.unlink(missing_ok=True)
        die("backup failed")
    ok(f"encrypted backup: {out} ({out.stat().st_size / 1e6:.1f} MB). Restoring needs secrets/muse_master_key.")


def _psql(sql: str, db: str = "postgres") -> subprocess.CompletedProcess:
    return subprocess.run(
        ["docker", "compose", "exec", "-T", "postgres", "sh", "-c",
         f'PGPASSWORD="$(cat /run/secrets/postgres_password)" psql -v ON_ERROR_STOP=1 -q -h 127.0.0.1 -U muse -d {db}'],
        cwd=ROOT, input=sql.encode(), capture_output=True,
    )


def cmd_restore(a) -> None:
    """Restores into a scratch database first and only swaps it in when that fully succeeded,
    so a bad or wrong backup never damages the running data. TimescaleDB needs
    timescaledb_pre_restore()/post_restore() around pg_restore into a fresh database."""
    need_setup()
    if not a.yes and not yes(f"replace the current database with {a.file}?", default=False):
        return
    step("Restoring into a scratch database")
    r = _psql("DROP DATABASE IF EXISTS muse_restore WITH (FORCE); CREATE DATABASE muse_restore;")
    if r.returncode:
        die(r.stderr.decode())
    r = _psql("CREATE EXTENSION IF NOT EXISTS timescaledb; SELECT timescaledb_pre_restore();", db="muse_restore")
    if r.returncode:
        die(r.stderr.decode())
    with open(a.file, "rb") as src:
        dec = subprocess.Popen(["docker", "compose", "--progress", "quiet", "run", "--rm", "--no-deps", "-T", "admin", "decrypt-stream"],
                               cwd=ROOT, stdin=src, stdout=subprocess.PIPE)
        restore = subprocess.run(
            ["docker", "compose", "exec", "-T", "postgres", "sh", "-c",
             'PGPASSWORD="$(cat /run/secrets/postgres_password)" pg_restore -h 127.0.0.1 -U muse -d muse_restore --no-owner --exit-on-error'],
            cwd=ROOT, stdin=dec.stdout, capture_output=True,
        )
        dec.wait()
    _psql("SELECT timescaledb_post_restore();", db="muse_restore")
    if dec.returncode:
        _psql("DROP DATABASE IF EXISTS muse_restore WITH (FORCE);")
        die("could not decrypt the backup (wrong key file, or not a Muse backup). Current data untouched.")
    if restore.returncode:
        _psql("DROP DATABASE IF EXISTS muse_restore WITH (FORCE);")
        die("restore failed; current data untouched:\n" + restore.stderr.decode()[-1500:])
    n = _psql("SELECT count(*) FROM event;", db="muse_restore")
    ok(f"backup restored into scratch database ({n.stdout.decode().split()[2] if n.returncode == 0 and len(n.stdout.split()) > 2 else '?'} events)")
    step("Swapping it in")
    users_of_db = [s for s, st in service_states().items() if st.get("State") == "running" and s not in ("postgres", "qdrant", "admin", "tls-proxy")]
    compose("stop", *users_of_db, check=False)
    keep = time.strftime("muse_before_restore_%Y%m%d_%H%M%S")
    r = _psql(f"ALTER DATABASE muse RENAME TO {keep}; ALTER DATABASE muse_restore RENAME TO muse;")
    if r.returncode:
        compose("start", *users_of_db, check=False)
        die("swap failed, nothing changed: " + r.stderr.decode())
    ok(f"previous database kept as {keep} (drop it with: ./muse drop-old-db {keep})")
    admin("migrate", capture=False)
    admin("rebuild", "--yes", capture=False)
    compose("start", *users_of_db, check=False)  # exactly what was running before
    ok("restored; the worker rebuilds vectors and profiles over the next cycles")


def cmd_drop_old_db(a) -> None:
    need_setup()
    if not re.fullmatch(r"muse_before_restore_\d{8}_\d{6}", a.name):
        die("only databases named muse_before_restore_YYYYMMDD_HHMMSS can be dropped this way")
    if not a.yes and not yes(f"permanently drop {a.name}?", default=False):
        return
    r = _psql(f"DROP DATABASE IF EXISTS {a.name} WITH (FORCE);")
    (ok if r.returncode == 0 else fail)(f"dropped {a.name}" if r.returncode == 0 else r.stderr.decode())


def cmd_rotate_keys(a) -> None:
    need_setup()
    text = read_secret("muse_master_key")
    lines = [l for l in text.splitlines() if l.strip()]
    kids = [int(l.split(":", 1)[0][1:]) for l in lines if re.match(r"^k\d+:", l)]
    new_kid = f"k{max(kids) + 1}"
    new = f"{new_kid}:{base64.b64encode(secrets.token_bytes(32)).decode()}"
    comments = [l for l in lines if l.startswith("#")]
    idx = [l for l in lines if l.startswith("idx:")]
    rest = [l for l in lines if re.match(r"^k\d+:", l)]
    shutil.copy(SECRETS / "muse_master_key", SECRETS / f"muse_master_key.before-{new_kid}")
    os.chmod(SECRETS / f"muse_master_key.before-{new_kid}", 0o600)
    _write_secret("muse_master_key", "\n".join(comments + idx + [new] + rest) + "\n", overwrite=True)
    ok(f"new encryption key {new_kid}; old keys stay in the file so old backups remain readable")
    running = [s for s, st in service_states().items() if st.get("State") == "running" and s not in ("postgres", "qdrant", "tls-proxy")]
    compose("up", "-d", "--no-build", "--force-recreate", *running, check=False)  # pick up the new key file
    r = admin("reseal", capture=False)
    (ok if r.returncode == 0 else fail)("all stored data re-encrypted with the new key" if r.returncode == 0 else "reseal failed: ./muse logs admin")


def cmd_rebuild(a) -> None:
    need_setup()
    if not a.yes and not yes("drop the catalog, profiles and vectors and rebuild them from events?", default=False):
        return
    admin("rebuild", "--yes", capture=False)


def main() -> None:
    ap = argparse.ArgumentParser(prog="muse", description="Set up and run Muse.", formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("setup", help="guided setup")
    s.add_argument("--mode", choices=["local", "lan", "tailscale"])
    s.add_argument("--jellyfin-url")
    s.add_argument("--jellyfin-key")
    s.add_argument("--tmdb-key")
    s.add_argument("--no-start", action="store_true")
    s.add_argument("--yes", action="store_true", help="accept defaults")
    s.set_defaults(fn=cmd_setup)
    for name, fn in (("up", cmd_up), ("down", cmd_down), ("doctor", cmd_doctor), ("upgrade", cmd_upgrade), ("keys", cmd_keys),
                     ("ca", cmd_ca), ("users", cmd_users), ("rotate-keys", cmd_rotate_keys)):
        sub.add_parser(name).set_defaults(fn=fn)
    for name, fn in (("restart", cmd_restart), ("logs", cmd_logs)):
        p = sub.add_parser(name)
        p.add_argument("services", nargs="*")
        p.set_defaults(fn=fn)
    p = sub.add_parser("status")
    p.add_argument("--json", action="store_true")
    p.add_argument("--url", action="store_true", help="print the status page URL")
    p.set_defaults(fn=cmd_status)
    p = sub.add_parser("import")
    p.add_argument("kind", choices=["youtube", "spotify", "soundcloud", "letterboxd", "imdb", "netflix", "trakt"])
    p.add_argument("file")
    p.add_argument("--user", required=True)
    p.add_argument("--profile")
    p.set_defaults(fn=cmd_import)
    p = sub.add_parser("export-user")
    p.add_argument("user_id")
    p.add_argument("--out")
    p.set_defaults(fn=cmd_export_user)
    for name, fn in (("forget-user", cmd_forget_user),):
        p = sub.add_parser(name)
        p.add_argument("user_id")
        p.add_argument("--yes", action="store_true")
        p.set_defaults(fn=fn)
    p = sub.add_parser("backup")
    p.add_argument("--out")
    p.set_defaults(fn=cmd_backup)
    p = sub.add_parser("restore")
    p.add_argument("file")
    p.add_argument("--yes", action="store_true")
    p.set_defaults(fn=cmd_restore)
    p = sub.add_parser("rebuild")
    p.add_argument("--yes", action="store_true")
    p.set_defaults(fn=cmd_rebuild)
    p = sub.add_parser("drop-old-db", help="drop a database kept by restore")
    p.add_argument("name")
    p.add_argument("--yes", action="store_true")
    p.set_defaults(fn=cmd_drop_old_db)
    a = ap.parse_args()
    try:
        a.fn(a)
    except KeyboardInterrupt:
        print()
        sys.exit(130)
    except BrokenPipeError:  # e.g. ./muse keys | head
        sys.exit(0)
    except subprocess.CalledProcessError as e:
        die(f"command failed: {' '.join(e.cmd)}")


if __name__ == "__main__":
    main()
