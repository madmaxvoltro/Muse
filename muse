def cmd_doctor(a) -> None:
    problems = 0

    def bad(msg: str) -> None:
        nonlocal problems
        problems += 1
        fail(msg)

    step("Setup")
    if not SECRETS.exists():
        bad("no secrets: run ./muse setup")
    else:
        mode = SECRETS.stat().st_mode & 0o777
        (ok if mode == 0o700 else bad)(f"secrets directory permissions {oct(mode)}" + ("" if mode == 0o700 else " (run: chmod 700 secrets)"))
        missing = [f for f in SECRET_FILES + ["qdrant.yaml"] if not (SECRETS / f).exists()]
        (ok if not missing else bad)("all secret files present" if not missing else f"missing secrets: {', '.join(missing)} (./muse setup fills them in)")
        mk = read_secret("muse_master_key")
        (ok if "idx:" in mk and re.search(r"^k\d+:", mk, re.M) else bad)("master key file valid" if "idx:" in mk else "master key file malformed")
    env = env_values()
    (ok if env else bad)(".env present" if env else ".env missing: run ./muse setup")
    if env.get("MUSE_BIND", "127.0.0.1") not in ("127.0.0.1", "::1", "localhost"):
        bad(f"MUSE_BIND={env.get('MUSE_BIND')}: the APIs should only listen on localhost (use the tls profile for other machines)")

    step("Containers")
    states = service_states()
    if not states:
        bad("nothing running: ./muse up")
    for svc, st in sorted(states.items()):
        if svc == "admin":
            (ok if st.get("ExitCode") == 0 else bad)(f"migrations {'done' if st.get('ExitCode') == 0 else 'failed: ./muse logs admin'}")
            continue
        health = st.get("Health") or st.get("State")
        (ok if health in ("healthy", "running") else bad)(f"{svc}: {st.get('Status', health)}")
        for pub in st.get("Publishers") or []:
            if pub.get("PublishedPort") and pub.get("URL") in ("0.0.0.0", "::"):
                bad(f"{svc} is published on all interfaces ({pub.get('URL')}:{pub.get('PublishedPort')})")

    step("Muse")
    r = admin("status", "--json")
    if r.returncode == 0:
        st = json.loads(r.stdout.decode())
        mig = st.get("migrations") or []
        (ok if "014_operations.sql" in mig else bad)(f"{len(mig)} migrations applied")
        last = st["worker"].get("last_cycle_at")
        (ok if last else warn)(f"worker last cycle: {last or 'not yet (first cycles download the model; give it a few minutes)'}")
        cat = st["catalog"]
        ok(f"catalog: {cat['titles']} titles, {cat['embedded']} embedded, {cat['waiting_for_embedding']} waiting")
        if st["events"]["total"] == 0:
            warn("no events yet: is the Jellyfin adapter running? ./muse logs jellyfin-adapter")
    else:
        bad("admin status failed: ./muse logs admin")

    step("Connections")
    if env.get("JELLYFIN_URL"):
        good, msg = check_jellyfin(env["JELLYFIN_URL"], read_secret("jellyfin_api_key"))
        (ok if good else bad)(msg)
    if read_secret("tmdb_api_key"):
        works = check_tmdb(read_secret("tmdb_api_key"))
        (ok if works else bad)("TMDB key " + ("works" if works else "rejected"))
    free = shutil.disk_usage(ROOT).free / 1e9
    (ok if free > 5 else bad)(f"{free:.0f} GB free disk")
    print()
    print(_c("32", "No problems found.") if not problems else _c("31", f"{problems} problem(s) found."))
    sys.exit(1 if problems else 0)


