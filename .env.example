# Copy to .env and fill in real values. Never commit the real .env — it's gitignored.

MUSE_POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Comma-separated source:key pairs, one per adapter. Generate each key separately
# (e.g. `openssl rand -hex 32`) — do not reuse keys across adapters.
MUSE_ADAPTER_KEYS=searxng:change-me,jellyfin:change-me,openwebui:change-me,navidrome:change-me,audiobookshelf:change-me,arr:change-me,mono:change-me

MUSE_SEARXNG_ADAPTER_KEY=change-me   # must match the searxng key above

# Fallback user_id used until identity resolution (see docs/architecture.md) is wired up.
MUSE_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000

# URL of your existing SearxNG instance that the adapter proxies to.
SEARXNG_UPSTREAM_URL=http://searxng:8080

# Your existing Jellyfin server. API key: Jellyfin admin -> Dashboard -> API Keys -> +
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=change-me
MUSE_JELLYFIN_ADAPTER_KEY=change-me   # must match the jellyfin key above

# Curator: discovery sources (either can be left blank, TMDB alone is enough to function)
TMDB_API_KEY=
TRAKT_CLIENT_ID=

# Curator: your existing arr-stack, for add/remove of auto-curated content
RADARR_URL=http://radarr:7878
RADARR_API_KEY=change-me
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=change-me
# Optional: pin which quality profile / root folder the curator uses. Leave blank to
# fall back to "whatever's first" in your Radarr/Sonarr config.
RADARR_QUALITY_PROFILE_NAME=
RADARR_ROOT_FOLDER=
SONARR_QUALITY_PROFILE_NAME=
SONARR_ROOT_FOLDER=

# arr adapter: same Radarr/Sonarr instance, read-only polling for watchlist/rejection signal
MUSE_ARR_ADAPTER_KEY=change-me   # must match the arr key in MUSE_ADAPTER_KEYS

# Query API + MCP (services/query-api, services/mcp-server).
# Household admin token: acts for everyone (list users, mint personal tokens, link accounts).
# Personal tokens for assistants are minted from it, or by Mono for its own users.
MUSE_ADMIN_TOKEN=change-me-to-a-long-random-value
# If the recommendation API has MUSE_READ_KEYS set, give the query API one of them here.
MUSE_QUERY_READ_KEY=

# Audio analyzer: stream Mono's files to listen to them (a stream-only token, set the same value
# as MONO_MUSE_STREAM_TOKEN on the Mono side). CPU by default; see docker-compose.gpu.yml.
MUSE_MONO_URL=http://mono:8420
MUSE_MONO_STREAM_TOKEN=change-me-to-a-long-random-value
MUSE_DEVICE=cpu

# Scheduler: weather for context (Open-Meteo, no key). Leave empty to skip.
MUSE_WEATHER_LAT=
MUSE_WEATHER_LON=

# Navidrome (optional, --profile navidrome). NAVIDROME_USERS="alice:pw,bob:pw" adds per-user stars.
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASSWORD=
NAVIDROME_USERS=
MUSE_NAVIDROME_ADAPTER_KEY=change-me   # must match the navidrome key in MUSE_ADAPTER_KEYS

# Audiobookshelf (optional, --profile audiobookshelf): an admin API token.
AUDIOBOOKSHELF_URL=
AUDIOBOOKSHELF_TOKEN=
MUSE_AUDIOBOOKSHELF_ADAPTER_KEY=change-me   # must match the audiobookshelf key in MUSE_ADAPTER_KEYS
