# Copy to .env and fill in real values. Never commit the real .env — it's gitignored.

MUSE_POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Comma-separated source:key pairs, one per adapter. Generate each key separately
# (e.g. `openssl rand -hex 32`) — do not reuse keys across adapters.
# Two special sources: `muse` (the client that shows Muse's questions, e.g. Vesper: posts
# answers and history uploads) and `import` (history imports only, e.g. the CLI in
# adapters/importer).
MUSE_ADAPTER_KEYS=searxng:change-me,jellyfin:change-me,openwebui:change-me,navidrome:change-me,audiobookshelf:change-me,arr:change-me,muse:change-me,import:change-me

MUSE_SEARXNG_ADAPTER_KEY=change-me   # must match the searxng key above

# Fallback user_id used until identity resolution (see docs/architecture.md) is wired up.
MUSE_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000

# URL of your existing SearxNG instance that the adapter proxies to.
SEARXNG_UPSTREAM_URL=http://searxng:8080

# Your existing Jellyfin server. API key: Jellyfin admin -> Dashboard -> API Keys -> +
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=change-me
MUSE_JELLYFIN_ADAPTER_KEY=change-me   # must match the jellyfin key above

# --- Taste engine (docs/recommender.md) -----------------------------------------------------
# Embeddings. local = in-process sentence-transformers (CPU, or GPU via docker-compose.gpu.yml);
# openai = any OpenAI-compatible /v1/embeddings server (Ollama, vLLM, TEI, LM Studio, OpenAI).
MUSE_EMBED_PROVIDER=local
MUSE_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B   # lighter: BAAI/bge-small-en-v1.5; gated: google/embeddinggemma-300m (needs HF_TOKEN)
MUSE_EMBED_DEVICE=auto        # auto | cpu | cuda | mps
MUSE_EMBED_DIM=               # optional Matryoshka truncation, e.g. 512 (halves memory, small quality cost)
MUSE_EMBED_BASE_URL=          # openai provider, e.g. http://ollama:11434/v1 or http://vllm:8000/v1
MUSE_EMBED_API_KEY=
MUSE_EMBED_ALLOW_EXTERNAL=false
HF_TOKEN=

# Optional LLM: item tone/themes, interest names, taste summary. none | ollama | vllm | lmstudio | openai | openrouter | anthropic
MUSE_LLM_PROVIDER=none
MUSE_LLM_BASE_URL=            # e.g. http://ollama:11434/v1 (defaults per provider)
MUSE_LLM_MODEL=               # e.g. qwen3:8b (ollama), claude-opus-5-5 (anthropic, default), gpt-... (openai)
MUSE_LLM_API_KEY=
# Endpoints outside your network (OpenAI, Anthropic, OpenRouter) are refused unless this is true.
MUSE_LLM_ALLOW_EXTERNAL=false
# With an external LLM: false keeps the two tasks that send your watched titles (interest
# names, taste summary) off it; item descriptions only send public metadata.
MUSE_LLM_PERSONAL_TASKS=true

# TMDB enrichment (keywords, credits, "fans also liked") for the embedding worker and the
# curator. Strongly recommended. v3 API key or v4 read-access token. TMDB sees which titles
# are looked up, never who watched what.
TMDB_API_KEY=
MUSE_TMDB_LANGUAGE=en-US      # e.g. nl-NL for Dutch overviews (Qwen3 embeddings are multilingual)

# Taste evolution: rhythms ("you watch comedy on weekday evenings") use local time.
MUSE_TIMEZONE=Europe/Amsterdam
# Per user, user_overlay.evolution_strength: 0 = off, 1 = subtle (default), 2 = strong.

# Curator thresholds, in ranker score units (preview with /recommendations?include_unavailable=true)
MUSE_CURATOR_ADD_SCORE=0.55
MUSE_CURATOR_REMOVE_SCORE=0.10

# Curator: discovery sources (either can be left blank, TMDB alone is enough to function)
TRAKT_CLIENT_ID=

# Curator: your existing arr-stack, for add/remove of auto-curated content
RADARR_URL=http://radarr:7878
RADARR_API_KEY=change-me
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=change-me
# Optional: pin which quality profile / root folder the curator uses. Leave blank to
# fall back to "whatever's first" in your Radarr/Sonarr config.
RADARR_QUALITY_PROFILE_NAME=
RADARR_ROOT_FOLDER=
SONARR_QUALITY_PROFILE_NAME=
SONARR_ROOT_FOLDER=

# arr adapter: same Radarr/Sonarr instance, read-only polling for watchlist/rejection signal
MUSE_ARR_ADAPTER_KEY=change-me   # must match the arr key in MUSE_ADAPTER_KEYS
