# You normally don't edit this by hand: ./muse setup writes .env for you.
# Secrets (keys, passwords, API keys) are NOT configured here: they live in ./secrets as files,
# created by ./muse setup and mounted into the containers as Docker secrets. See SECURITY.md.

MUSE_MODE=local                     # local | lan | tailscale
COMPOSE_FILE=docker-compose.yml     # setup adds docker-compose.vesper.yml / docker-compose.gpu.yml when needed
COMPOSE_PROFILES=                   # optional parts: tls, curator, arr, searxng, mcp

# Where the APIs listen. Keep 127.0.0.1; use mode lan/tailscale (the tls profile) for other machines.
MUSE_BIND=127.0.0.1
MUSE_RECO_PORT=8770
MUSE_INGEST_PORT=8771
MUSE_TLS_HOST=                      # lan/tailscale: the address or name clients use
MUSE_TLS_BIND=127.0.0.1             # lan/tailscale: the interface the HTTPS proxy listens on
MUSE_TLS_PORT=8443

JELLYFIN_URL=http://127.0.0.1:8096  # key: secrets/jellyfin_api_key

# Embeddings: local (CPU/GPU, in-process) or openai (any OpenAI-compatible server: Ollama, vLLM, TEI...)
MUSE_EMBED_PROVIDER=local
MUSE_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
MUSE_EMBED_DEVICE=auto
MUSE_EMBED_DIM=
MUSE_EMBED_BASE_URL=
MUSE_EMBED_ALLOW_EXTERNAL=false

# Optional LLM: none | ollama | vllm | lmstudio | openai | openrouter | anthropic (key: secrets/llm_api_key)
MUSE_LLM_PROVIDER=none
MUSE_LLM_BASE_URL=
MUSE_LLM_MODEL=
MUSE_LLM_ALLOW_EXTERNAL=false       # endpoints outside your network are refused unless true
MUSE_LLM_PERSONAL_TASKS=true        # false: never send watched titles to an external LLM

MUSE_TIMEZONE=Europe/Amsterdam      # taste rhythms use local time
MUSE_TMDB_LANGUAGE=en-US            # key: secrets/tmdb_api_key

# Curator (profile `curator`); keys: secrets/radarr_api_key, secrets/sonarr_api_key
RADARR_URL=
SONARR_URL=
RADARR_QUALITY_PROFILE_NAME=
RADARR_ROOT_FOLDER=
SONARR_QUALITY_PROFILE_NAME=
SONARR_ROOT_FOLDER=
TRAKT_CLIENT_ID=
MUSE_CURATOR_ADD_SCORE=0.55
MUSE_CURATOR_REMOVE_SCORE=0.10

# arr/searxng adapters: events without a per-person source go to this user
MUSE_DEFAULT_USER_ID=
SEARXNG_UPSTREAM_URL=

# MCP server (profile `mcp`); keys: secrets/mcp_read_key, secrets/mcp_answer_key
MUSE_MCP_USER_ID=
MUSE_MCP_PORT=8002
