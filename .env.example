# Copy to .env and fill in real values. Never commit the real .env — it's gitignored.

MUSE_POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Comma-separated source:key pairs, one per adapter. Generate each key separately
# (e.g. `openssl rand -hex 32`) — do not reuse keys across adapters.
MUSE_ADAPTER_KEYS=searxng:change-me,jellyfin:change-me,openwebui:change-me,navidrome:change-me,audiobookshelf:change-me,arr:change-me

MUSE_SEARXNG_ADAPTER_KEY=change-me   # must match the searxng key above

# Fallback user_id used until identity resolution (see docs/architecture.md) is wired up.
MUSE_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000

# URL of your existing SearxNG instance that the adapter proxies to.
SEARXNG_UPSTREAM_URL=http://searxng:8080

# Your existing Jellyfin server. API key: Jellyfin admin -> Dashboard -> API Keys -> +
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=change-me
MUSE_JELLYFIN_ADAPTER_KEY=change-me   # must match the jellyfin key above

# Curator: discovery sources (either can be left blank, TMDB alone is enough to function)
TMDB_API_KEY=
TRAKT_CLIENT_ID=

# Curator: your existing arr-stack, for add/remove of auto-curated content
RADARR_URL=http://radarr:7878
RADARR_API_KEY=change-me
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=change-me
# Optional: pin which quality profile / root folder the curator uses. Leave blank to
# fall back to "whatever's first" in your Radarr/Sonarr config.
RADARR_QUALITY_PROFILE_NAME=
RADARR_ROOT_FOLDER=
SONARR_QUALITY_PROFILE_NAME=
SONARR_ROOT_FOLDER=

# arr adapter: same Radarr/Sonarr instance, read-only polling for watchlist/rejection signal
MUSE_ARR_ADAPTER_KEY=change-me   # must match the arr key in MUSE_ADAPTER_KEYS
